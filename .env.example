# Runtime
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# MongoDB — replace with your local or Atlas connection string
# Local: mongodb://localhost:27017/whatsapp-gateway
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/whatsapp-gateway
MONGODB_URI=mongodb://localhost:27017/whatsapp-gateway
MONGODB_DB_NAME=whatsapp-gateway

# JWT — generate a random 64-character string for production
# Example: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=24h

# API Keys — generate a random pepper (min 8 characters)
# Example: openssl rand -hex 16
API_KEY_PEPPER=CHANGE_THIS_PEPPER_STRING_IN_PRODUCTION

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3333

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Webhooks
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_BASE_RETRY_MS=1000
WEBHOOK_MAX_RETRY_MS=60000
WEBHOOK_RETRY_INTERVAL_MS=10000

# QR / Pairing
QR_TTL_SECONDS=30

# Instance Management
INSTANCE_STARTUP_CONCURRENCY=5
MAX_RECONNECT_ATTEMPTS=10
MAX_RECONNECT_DELAY_MS=300000

# Instance Lease (multi-node safety)
INSTANCE_LEASE_TTL_MS=30000
INSTANCE_LEASE_RENEW_INTERVAL_MS=10000

# Logging
LOG_LEVEL=info

# Metrics
METRICS_ENABLED=true

# Media Storage
MEDIA_STORAGE=local
DATA_DIR=./data
MAX_UPLOAD_SIZE=20971520
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/3gpp,audio/mpeg,audio/ogg,audio/ogg;codecs=opus,application/pdf,text/plain

# Auth Encryption (optional — 32+ char secret; enables AES-256-GCM at rest for WhatsApp auth state; leave empty to store plain)
AUTH_ENCRYPTION_KEY=

# Request
MAX_REQUEST_BODY_SIZE=10mb