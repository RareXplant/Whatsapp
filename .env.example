WEBHOOK_MAX_RETRIES=5
WEBHOOK_BASE_RETRY_MS=1000
WEBHOOK_MAX_RETRY_MS=60000

# QR / Pairing
QR_TTL_SECONDS=30

# Instance Management
INSTANCE_STARTUP_CONCURRENCY=5
MAX_RECONNECT_ATTEMPTS=10
MAX_RECONNECT_DELAY_MS=300000

# Logging
LOG_LEVEL=info

# Metrics
METRICS_ENABLED=true

# Media Storage
MEDIA_STORAGE=local
DATA_DIR=./data

# Auth Encryption (optional)
AUTH_ENCRYPTION_KEY=

# Request
MAX_REQUEST_BODY_SIZE=10mb
