# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3333

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Webhooks
